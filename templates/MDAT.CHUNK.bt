//------------------------------------------------
// File: MDAT.CHUNK.bt
// Authors: onejeuu, DeTTK
// Version: 1.1
// Purpose: Parse world chunk data.
// Category: STALCRAFT
// File Mask: *.chunk
//------------------------------------------------

BigEndian();

local int SECTION_SIZE = 16 * 16 * 16;  // 4096
local int NIBBLE_SIZE  = 16 * 16 * 8;   // 2048

typedef struct {
    int32 fullSize <name="Full Size">;
    int32 sectionMask <name="Section Mask", format=binary>;
    int32 addMask <name="Add Mask", format=binary>;
    int32 fixedSize <name="Fixed Size">;
} ChunkHeader;

ChunkHeader header <name="Header">;

local int sectionCount = 0;
local int addCount = 0;
local int i;
for (i = 0; i < 16; i++) {
    if ((header.sectionMask >> i) & 1) sectionCount++;
    if ((header.addMask >> i) & 1) addCount++;
}

typedef struct { uchar data[SECTION_SIZE]; } BlockSection;
typedef struct { uchar data[NIBBLE_SIZE];  } NibbleSection;

BlockSection blocks[sectionCount] <name="Blocks", optimize=false, bgcolor=cLtGreen>;
NibbleSection meta[sectionCount] <name="Metadata", optimize=false, bgcolor=cLtBlue>;
NibbleSection blockLight[sectionCount] <name="Block Light", optimize=false, bgcolor=cGray>;
NibbleSection skyLight[sectionCount*2] <name="Sky Light", optimize=false, bgcolor=cDkGray>;

if (addCount > 0) {
    NibbleSection add[addCount] <name="Add", optimize=false, bgcolor=cDkYellow>;
}

local int extraSize = FileSize() - FTell();
if (extraSize > 0) {
    uchar extra[extraSize] <name="Extra", bgcolor=cDkGreen>;
}
