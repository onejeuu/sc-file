//------------------------------------------------
// File: MDAT.CHUNK.bt
// Authors: onejeuu, DeTTK
// Version: 2.0
// Purpose: Parse decompressed world chunk data.
// Category: STALCRAFT
// File Mask: *.chunk
//------------------------------------------------

// The file consists of the 20-byte MDAT chunk header followed by the
// ZSTD-decompressed payload. It is not a template for a raw MDAT sector.

BigEndian();

local int SECTION_SIZE = 16 * 16 * 16;  // 4096
local int NIBBLE_SIZE  = 16 * 16 * 8;   // 2048
local int BIOME_SIZE   = 16 * 16;       // 256

typedef struct {
    uint32 recordSize <name="Record Size">;
    uint32 sectionMask <name="Section Mask", format=binary>;
    uint32 addMask <name="Add Mask", format=binary>;
    uint32 terrainSize <name="Terrain Size">;
    uint32 compressedSize <name="Compressed Size">;
} ChunkHeader;

ChunkHeader header <name="Header">;

local int sectionCount = 0;
local int addCount = 0;
local int i;
for (i = 0; i < 16; i++) {
    sectionCount += (header.sectionMask >> i) & 1;
    addCount += (header.addMask >> i) & 1;
}

typedef struct { uchar data[SECTION_SIZE]; } BlockSection;
typedef struct { uchar data[NIBBLE_SIZE]; } NibblePlane;

BlockSection blocks[sectionCount] <name="Blocks", optimize=false, bgcolor=cLtGreen>;
NibblePlane metadata[sectionCount] <name="Metadata", optimize=false, bgcolor=cLtBlue>;
NibblePlane lighting[sectionCount * 3] <name="Lighting", optimize=false, bgcolor=cGray>;

NibblePlane add[addCount] <name="Add", optimize=false, bgcolor=cDkYellow>;

uchar biomes[BIOME_SIZE] <name="Biomes", bgcolor=cPurple>;

if (!FEof()) {
    uint32 recordCount <name="Record Count">;
    local int recordsSize = FileSize() - FTell();

    if (recordsSize > 0) {
        uchar records[recordsSize] <name="Records", bgcolor=cDkGreen>;
    }
}
