//------------------------------------------------
// File: HASHMAP.bt
// Authors: onejeuu
// Version: 2.1
// Purpose: Parse launcher hash mappings.
// Category: STALCRAFT
// File Mask: *.map
//------------------------------------------------


// Define byte order

BigEndian();


// Data Types

typedef struct {
    ushort size <bgcolor=cDkYellow>;
    if ( size > 0 ) char data[size] <bgcolor=cYellow, optimize=false>;
} String <read=(exists(data) ? data : "")>;

typedef struct {
    String path <name="Path">;
    char sha1[20] <name="SHA-1", fgcolor=cGreen, bgcolor=cDkGreen>;
} FileEntry;


// File

uint count <name="Entry Count", bgcolor=cPurple>;
FileEntry entries[count] <name="Entry", optimize=false>;
