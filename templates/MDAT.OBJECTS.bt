//------------------------------------------------
// File: MDAT.OBJECTS.bt
// Authors: onejeuu
// Version: 2.0
// Purpose: Parse decompressed objects payload (v7.x).
// Category: STALCRAFT
// File Mask: *.objects
//------------------------------------------------

BigEndian();

// Types

typedef struct {
    ushort size <name="Size">;
    if (size > 0) {
        char data[size] <name="Data", bgcolor=cYellow, optimize=false>;
    }
} String;

typedef struct {
    uint64 most <format=hex>;
    uint64 least <format=hex>;
} UUID;


// File Content

typedef struct {
    local uint size = 0;
    local uint shift = 0;
    local ubyte lastByte;

    do {
        ubyte encodedSize <name="Size", fgcolor=cGreen, format=hex>;
        size |= (encodedSize & 0x7F) << shift;
        shift += 7;
        lastByte = encodedSize;
    } while (lastByte & 0x80);

    local int64 _end = FTell() + size;

    uint64 typeHash <name="Type Hash", format=hex, fgcolor=cLtBlue>;
    uint flags <name="Flags", format=hex>;
    ubyte flags2 <name="Flags 2", format=hex>;

    if (flags & 0x80) {
        UUID group <name="Group">;
    }
    if (flags & 0x8000) {
        String materialPatch <name="Material Patch">;
    }
    if (flags & 0x4000) {
        int clientCsv <name="Client CSV">;
    }
    if (flags & 0x2000) {
        int clientCbv <name="Client CBV">;
    }

    UUID uuid <name="UUID", fgcolor=cLtBlue>;
    float transform[9] <name="Transform", bgcolor=cLtGreen>;
    float position[3] <name="Position", bgcolor=cLtBlue>;

    local int64 dataSize = _end - FTell();
    if (dataSize > 0) {
        ubyte data[dataSize] <name="Data", bgcolor=cDkGreen, optimize=false>;
    }
} Object;

local uint objectCount = 0;
local uint objectCountShift = 0;
local ubyte lastCountByte;

do {
    ubyte encodedCount <name="Object Count", fgcolor=cAqua, format=hex>;
    objectCount |= (encodedCount & 0x7F) << objectCountShift;
    objectCountShift += 7;
    lastCountByte = encodedCount;
} while (lastCountByte & 0x80);

Object objects[objectCount] <name="Objects", optimize=false>;
