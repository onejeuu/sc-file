//------------------------------------------------
// File: MDAT.bt
// Authors: onejeuu, DeTTK
// Version: 1.1
// Purpose: Parse world region caches.
// Category: STALCRAFT
// File Mask: *.mdat
//------------------------------------------------

local uint32 SIZE = 32 * 32;  // 1024

BigEndian();

typedef struct {
    int32 offset <name="Offset">;
    int32 sectorCount <name="Sector Count">;
    GUID uuid <name="UUID", fgcolor=cLtBlue>;
} Metadata;

typedef struct {
    int32 recordSize <name="Record Size">;
    int32 sectionMask <name="Section Mask">;
    int32 addMask <name="Add Mask">;
    int32 terrainSize <name="Terrain Size">;
    int32 compressedSize <name="Compressed Size", fgcolor=cDkGreen>;

    // ZSTD compressed data
    // after can be sectors slack (stale data)
    char data[compressedSize] <name="Data", bgcolor=cDkGreen>;

    // padding
    local uint _current = FTell();
    local uint _aligned = (_current + 0xFFF) & ~0xFFF;
    local uint _padding = _aligned - _current;

    if(_padding > 0) {
        char padding[_padding] <bgcolor=cGray, hidden=true>;
    }
} Chunk;

// metadata
Metadata metadata[SIZE] <name="Metadata">;

// terrain chunks
local uint _counter;
while(_counter < SIZE & !FEof()) {
    Chunk chunk <name="Chunk">;
    _counter++;
}
