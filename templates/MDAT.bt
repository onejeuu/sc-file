//------------------------------------------------
// File: MDAT.bt
// Authors: onejeuu, DeTTK
// Version: 2.0
// Purpose: Parse world region caches (v6.0).
// Category: STALCRAFT
// File Mask: *.mdat
//------------------------------------------------

BigEndian();

// File Content
// Metadata

local uint SIZE = 32 * 32;  // 1024

typedef struct {
    int offset <name="Offset">;
    int sectorCount <name="Sector Count">;
    GUID uuid <name="UUID", fgcolor=cLtBlue>;
} Metadata;

Metadata metadata[SIZE] <name="Metadata">;


// Chunks

typedef struct {
    int recordSize <name="Record Size">;
    int sectionMask <name="Section Mask">;
    int addMask <name="Add Mask">;
    int terrainSize <name="Terrain Size">;

    // Chunk payload (zstd)
    int chunkSize <name="Data Size", fgcolor=cGreen>;
    if (chunkSize > 0) {
        ubyte data[chunkSize] <name="Data", comment="zstd", bgcolor=cDkGreen>;
    }

    // Objects payload (zstd)
    int objectsSize <name="Objects Size", fgcolor=cYellow>;
    if (objectsSize > 0) {
        ubyte objects[objectsSize] <name="Objects", comment="zstd", bgcolor=cDkYellow>;
    }

    // Padding
    local uint _current = FTell();
    local uint _aligned = (_current + 0xFFF) & ~0xFFF;
    local uint _padding = _aligned - _current;

    if(_padding > 0) {
        char padding[_padding] <bgcolor=cGray, hidden=true>;
    }
} Chunk;

local uint _counter;
while(_counter < SIZE & !FEof()) {
    Chunk chunk <name="Chunk">;
    _counter++;
}
