//------------------------------------------------
// File: MDAT.bt
// Authors: onejeuu, DeTTK
// Version: 3.0
// Purpose: Parse world region cache container (v7.x).
// Category: STALCRAFT
// File Mask: *.mdat
//------------------------------------------------

BigEndian();

// File Content
// Metadata

local uint CHUNK_COUNT = 32 * 32;  // 1024 chunks
local uint SECTOR_SIZE = 4 * 1024;  // 4 KiB

typedef struct {
    int sectorOffset <name="Sector Offset">;
    int sectorCount <name="Sector Count">;
    uint64 chunkKey <name="Chunk Key", format=hex, fgcolor=cLtBlue>;
} Metadata;

Metadata metadata[CHUNK_COUNT] <name="Metadata">;


// Chunks

local int64 _counter;
local int64 _end;

typedef struct {
    // Chunk payload
    int streamLength <name="Stream Length", fgcolor=cLtRed>;
    uint64 chunkKey <name="Chunk Key", format=hex, fgcolor=cLtBlue>;
    int sectionMask <name="Section Mask", format=binary, bgcolor=cPurple>;
    int addMask <name="Add Mask", format=binary, bgcolor=cPurple>;
    int dataSize <name="Uncompressed Size", fgcolor=cLtGreen>;
    int chunkSize <name="Compressed Size", fgcolor=cGreen>;

    // Chunk data (zstd)
    if (chunkSize > 0) {
        ubyte chunk[chunkSize] <name="Chunk", comment="zstd", bgcolor=cDkGreen>;
    }

    // Objects payload data (zstd)
    int objectsSize <name="Objects Size", fgcolor=cYellow>;
    if (objectsSize > 0) {
        ubyte objects[objectsSize] <name="Objects", comment="zstd", bgcolor=cDkYellow>;
    }

    // Padding
    local int64 _padding = _end - FTell();

    if(_padding > 0) {
        char padding[_padding] <bgcolor=cGray, hidden=true>;
    }
} Chunk;

void parseChunk(Metadata &entry) {
    if (entry.sectorOffset > 0) {
        FSeek((int64)entry.sectorOffset * SECTOR_SIZE);
        _end = FTell() + (int64)entry.sectorCount * SECTOR_SIZE;
        Chunk chunk <name="Chunk">;
    }
}

for (_counter = 0; _counter < CHUNK_COUNT; _counter++)
    parseChunk(metadata[_counter]);
